{{/* Pattern 6: Context + Request body */}}
		ctx := r.Context()

		// Parse request body
		var req {{.Handler.Signature.RequestType.FullName}}
		if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
			writeError(w, err)
			return
		}

		resp, err := c.{{.CtrlField}}.{{.Handler.Name}}(ctx, req)
		if err != nil {
			writeError(w, err)
			return
		}
		writeJSON(w, http.StatusOK, resp)
