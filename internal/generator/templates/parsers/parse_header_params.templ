{{/* Shared: Parse header parameters from HTTP headers */}}
{{- if .Handler.Signature.HeaderParams}}
		// Parse headers
{{- range .Handler.Signature.HeaderParams}}
{{- if .IsOptional}}
		// Optional header: {{.HeaderName}}
		if {{.FieldName}}Val := r.Header.Get("{{.HeaderName}}"); {{.FieldName}}Val != "" {
{{- if eq .Type.Name "string"}}
			req.{{.FieldName}} = &{{.FieldName}}Val
{{- else if eq .Type.Name "int"}}
			{{.FieldName}}Parsed := parsers.ParseIntOrZero({{.FieldName}}Val)
			req.{{.FieldName}} = &{{.FieldName}}Parsed
{{- else if eq .Type.Name "int64"}}
			{{.FieldName}}Parsed := parsers.ParseInt64OrZero({{.FieldName}}Val)
			req.{{.FieldName}} = &{{.FieldName}}Parsed
{{- else if eq .Type.Name "uint64"}}
			{{.FieldName}}Parsed := parsers.ParseUint64OrZero({{.FieldName}}Val)
			req.{{.FieldName}} = &{{.FieldName}}Parsed
{{- else if eq .Type.Name "bool"}}
			{{.FieldName}}Parsed := parsers.ParseBoolOrFalse({{.FieldName}}Val)
			req.{{.FieldName}} = &{{.FieldName}}Parsed
{{- else if eq .Type.Name "float64"}}
			{{.FieldName}}Parsed := parsers.ParseFloat64OrZero({{.FieldName}}Val)
			req.{{.FieldName}} = &{{.FieldName}}Parsed
{{- else if eq .Type.PackageName "uuid"}}
			{{.FieldName}}Parsed := parsers.ParseUUIDOrNil({{.FieldName}}Val)
			req.{{.FieldName}} = &{{.FieldName}}Parsed
{{- end}}
		}
{{- else}}
		// Required header: {{.HeaderName}}
		if {{.FieldName}}Val := r.Header.Get("{{.HeaderName}}"); {{.FieldName}}Val != "" {
{{- if eq .Type.Name "string"}}
			req.{{.FieldName}} = {{.FieldName}}Val
{{- else if eq .Type.Name "int"}}
			req.{{.FieldName}} = parsers.ParseIntOrZero({{.FieldName}}Val)
{{- else if eq .Type.Name "int64"}}
			req.{{.FieldName}} = parsers.ParseInt64OrZero({{.FieldName}}Val)
{{- else if eq .Type.Name "uint64"}}
			req.{{.FieldName}} = parsers.ParseUint64OrZero({{.FieldName}}Val)
{{- else if eq .Type.Name "bool"}}
			req.{{.FieldName}} = parsers.ParseBoolOrFalse({{.FieldName}}Val)
{{- else if eq .Type.Name "float64"}}
			req.{{.FieldName}} = parsers.ParseFloat64OrZero({{.FieldName}}Val)
{{- else if eq .Type.PackageName "uuid"}}
			req.{{.FieldName}} = parsers.ParseUUIDOrNil({{.FieldName}}Val)
{{- end}}
		}
{{- end}}
{{- end}}
{{- end}}
