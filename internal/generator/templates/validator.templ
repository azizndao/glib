{{/* Validator initialization template - generates validator.gen.go */}}
// Code generated by glib. DO NOT EDIT.

package {{.PackageName}}

import (
    "slices"
	"github.com/azizndao/glib/utils/parsers"
	glib "github.com/azizndao/glib/validator"
{{- range .Languages}}
	locales_{{.}} "github.com/go-playground/locales/{{.}}"
	trans_{{.}} "github.com/go-playground/validator/v10/translations/{{.}}"
{{- end}}
	ut "github.com/go-playground/universal-translator"
	"github.com/go-playground/validator/v10"
)

var suportedLocales = []string{
	{{- range .Languages}}
	    "{{.}}",
	{{- end}}
}

var defaultLocale = "{{.DefaultLanguage}}"

// initValidator initializes the validator with configured locales
func initValidator() *glib.Validator {
	v := validator.New()

	// Create locale instances
{{- range .Languages}}
	locale_{{.}} := locales_{{.}}.New()
{{- end}}

	// Initialize UniversalTranslator with {{.DefaultLanguage}} as fallback
	uni := ut.New(locale_{{.DefaultLanguage}}{{range .Languages}}, locale_{{.}}{{end}})

	// Register translations for each language
{{- range .Languages}}
	if trans, _ := uni.GetTranslator("{{.}}"); trans != nil {
		_ = trans_{{.}}.RegisterDefaultTranslations(v, trans)
	}
{{- end}}

	return glib.NewValidatorWithTranslator(v, uni, defaultLocale)
}


// DetectLanguageOrDefault parses Accept-Language header and returns the best matching language
// Falls back to "{{.DefaultLanguage}}" if no language specified or no match found
func DetectLanguageOrDefault(req *http.Request) string {
	acceptLanguage := req.Header.Get("Accept-Language")
	lang := parsers.DetectLanguage(acceptLanguage, defaultLocale)


	if locale := req.URL.Query().Get("{{.LocaleQueryParamKey}}"); locale != "" {
		lang = locale
	}

	// Validate that the detected language is in our supported list
	if slices.Contains(suportedLocales, lang) {
		return lang
	}

	return defaultLocale // Fallback to configured default
}
