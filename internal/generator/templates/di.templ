				nextCalled = true
				next.ServeHTTP(capture, req.HTTPRequest())
				return glib.Response{} // Handler already wrote response
			}

			resp := mw(req, nextFn)

			// Only write response if:
			// 1. next() was NOT called, OR
			// 2. next() was called but the handler didn't write to ResponseWriter
