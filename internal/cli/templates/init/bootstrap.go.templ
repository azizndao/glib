package main

import (
	"context"
	"{{.Module}}/generated"
	"net/http"
	"time"

	"github.com/go-chi/chi/v5"
	"github.com/go-chi/chi/v5/middleware"
)

// Bootstrap initializes and configures the application.
// This file is yours to edit - customize as needed.
func Bootstrap(ctx context.Context) (http.Handler, error) {
	container, err := generated.InitContainer(ctx)
	if err != nil {
		return nil, err
	}

	router := chi.NewRouter()

	router.Use(middleware.RequestID)
	router.Use(middleware.RealIP)
	router.Use(middleware.Logger)
	router.Use(middleware.Recoverer)
	router.Use(middleware.Timeout(60 * time.Second))

	if err := generated.RegisterRoutes(router, container); err != nil {
		return nil, err
	}

	return router, nil
}
